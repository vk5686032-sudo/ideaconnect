# Physical device on the same Wi-Fi as the backend:
EXPO_PUBLIC_API_URL=http://192.168.0.156:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://192.168.0.156:5000

# Android emulator instead? The host machine is 10.0.2.2:
