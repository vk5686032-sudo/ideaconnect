# Mobile app URLs.
#
# Do NOT hardcode an IP here. `npm start` runs scripts/lan-ip.js first (the
# prestart hook), which detects this machine's LAN address, checks the backend
# answers on it, and writes .env.local with the right values. .env.local is
# gitignored, so nothing stale is ever committed and the URL follows you when
# the wifi changes.
#
# If the detection picks the wrong adapter, override it:
#   LAN_IP=<address> npm start
# For an Android emulator the host is 10.0.2.2 (nothing answers there from the
# host's own stack, so the override is trusted without a health check):
#   LAN_IP=10.0.2.2 npm start
#
# The web app needs none of this - frontend/vite.config.js proxies /api and
# /socket.io so the browser sees a single origin.

# EAS project id - required for real push tokens (Phase 7 build); leave empty in Expo Go
EXPO_PUBLIC_EAS_PROJECT_ID=
