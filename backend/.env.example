PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ideaconnect

# Password policy
# Minimum 8 characters, enforced in THREE places that share no constant:
#   1. the zod request schemas (PASSWORD_MIN, the exported authority)
#   2. the Mongoose minlength on models/User.js
#   3. a copy in each client - frontend Login/Register/ResetPassword/Settings
#      and mobile login/register/reset-password/settings
# Change all of them together, or users get a client that accepts a password
# the server then rejects. Note that LOGIN is deliberately min(1) and must
# stay that way: accounts created before the minimum was raised still hold
# shorter passwords, and enforcing the signup minimum on the login form locks
# those users out of both clients entirely. See CLAUDE.md "Things to be
# careful about".


# JWT
# REQUIRED in production. Compose refuses to start without it.
# Generate: openssl rand -hex 48   (or: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# Never reuse a value you have committed anywhere, and never ship the default
# below to a real deployment - it is in this repository's history.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=15m


# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI API (OpenAI or Gemini)
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Mobile app deep-link scheme. Must match `scheme` in mobile/app.json.
# Verification and password-reset emails add an "open in app" link built from
# this. Leave blank to send web links only.
MOBILE_SCHEME=ideaconnect

# Refresh tokens (rotating, hashed server-side, max 5 devices)
REFRESH_TOKEN_EXPIRE_DAYS=30

# API rate limit: requests per 15 min per IP.
# Private addresses (localhost, LAN) are skipped in DEVELOPMENT only, so local
# work is not throttled. In production they are never skipped - that is how rate
# limiting was silently disabled behind the compose proxy.
RATE_LIMIT_MAX=600

# Credential endpoints: /auth/login, /register, /forgot-password,
# /reset-password/:token, /resend-verification. 10 per 15 minutes. The global
# bucket above is sized for page loads, which is no defence against password
# guessing. /auth/refresh is deliberately NOT limited - the mobile client
# refreshes silently and a tight bucket there logs people out for nothing.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Serve the OpenAPI UI (/api/v1/docs) and spec (/api/v1/docs.json). Off in
# production, where the spec is an unauthenticated map of every route. Turn on
# deliberately, e.g. behind an IP allowlist at the proxy.
SERVE_API_DOCS=false

