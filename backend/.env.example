PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ideaconnect

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=15m

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI API (OpenAI or Gemini)
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Mobile app deep-link scheme. Must match `scheme` in mobile/app.json.
# Verification and password-reset emails add an "open in app" link built from
# this. Leave blank to send web links only.
MOBILE_SCHEME=ideaconnect

# Refresh tokens (rotating, hashed server-side, max 5 devices)
REFRESH_TOKEN_EXPIRE_DAYS=30

# API rate limit: requests per 15 min per IP (localhost is exempt)
RATE_LIMIT_MAX=600
