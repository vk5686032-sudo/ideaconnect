{
  "primitives": {
    "color": {
      "violet-500": "#A78BFA",
      "violet-600": "#7C3AED",
      "violet-700": "#6D28D9",
      "cyan-500": "#06B6D4",
      "cyan-600": "#0891B2",
      "emerald-500": "#10B981",
      "amber-500": "#F59E0B",
      "rose-500": "#F43F5E",
      "white": "#FFFFFF",
      "black": "#000000",
      "zinc-50": "#FAFAFA",
      "zinc-100": "#F4F4F4",
      "zinc-200": "#E4E4E7",
      "zinc-300": "#D4D4D8",
      "zinc-400": "#A1A1AA",
      "zinc-500": "#71717A",
      "zinc-600": "#52525B",
      "zinc-700": "#3F3F46",
      "zinc-800": "#27272A",
      "zinc-900": "#18181B",
      "zinc-950": "#09090B"
    },
    "font": {
      "display": "Space Grotesk",
      "body": "DM Sans",
      "mono": "Space Grotesk"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px"
    },
    "borderRadius": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "xl": "24px",
      "full": "9999px"
    },
    "shadow": {
      "sm": "0 1px 2px rgba(0,0,0,0.04)",
      "md": "0 4px 12px rgba(0,0,0,0.08)",
      "lg": "0 12px 32px rgba(0,0,0,0.12)",
      "glass": "0 8px 32px rgba(0,0,0,0.12), inset 0 1px 0 rgba(255,255,255,0.1)"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px",
      "5xl": "48px",
      "6xl": "60px",
      "7xl": "72px"
    },
    "lineHeight": {
      "tight": "1.1",
      "snug": "1.375",
      "normal": "1.5",
      "relaxed": "1.625"
    },
    "fontWeight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "transition": {
      "instant": "100ms",
      "fast": "200ms",
      "normal": "300ms",
      "slow": "500ms",
      "cinematic": "800ms",
      "epic": "1200ms"
    },
    "easing": {
      "spring": "cubic-bezier(0.32, 0.72, 0, 1)",
      "springSharp": "cubic-bezier(0.4, 0, 0.2, 1)",
      "expo": "cubic-bezier(0.16, 1, 0.3, 1)",
      "bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "motion": {
      "entryDelay": "100ms",
      "stagger": "80ms",
      "parallaxDepth": "0.15",
      "magneticRadius": "80px"
    }
  },
  "semantic": {
    "color": {
      "primary": "{primitives.color.violet-600}",
      "primaryHover": "{primitives.color.violet-700}",
      "primaryMuted": "{primitives.color.violet-500}",
      "accent": "{primitives.color.cyan-500}",
      "accentHover": "{primitives.color.cyan-600}",
      "success": "{primitives.color.emerald-500}",
      "warning": "{primitives.color.amber-500}",
      "destructive": "{primitives.color.rose-500}",
      "background": "{primitives.color.white}",
      "foreground": "{primitives.color.zinc-900}",
      "card": "{primitives.color.white}",
      "cardForeground": "{primitives.color.zinc-900}",
      "muted": "{primitives.color.zinc-100}",
      "mutedForeground": "{primitives.color.zinc-500}",
      "border": "{primitives.color.zinc-200}",
      "inputBorder": "{primitives.color.zinc-300}",
      "focusRing": "{primitives.color.violet-600}"
    },
    "dark": {
      "background": "#0F0F23",
      "foreground": "#F8FAFC",
      "card": "#1E1D35",
      "cardForeground": "#F8FAFC",
      "muted": "#27273B",
      "mutedForeground": "#94A3B8",
      "border": "#4C1D95",
      "cardBorder": "#4338CA"
    },
    "font": {
      "display": "{primitives.font.display}",
      "body": "{primitives.font.body}",
      "mono": "{primitives.font.mono}"
    },
    "fontSize": {
      "display": {
        "hero": "56px",
        "h1": "48px",
        "h2": "40px",
        "h3": "32px"
      },
      "body": {
        "lg": "18px",
        "base": "16px",
        "sm": "14px",
        "xs": "12px"
      }
    },
    "fontWeight": {
      "normal": "{primitives.fontWeight.normal}",
      "medium": "{primitives.fontWeight.medium}",
      "semibold": "{primitives.fontWeight.semibold}",
      "bold": "{primitives.fontWeight.bold}"
    },
    "lineHeight": {
      "tight": "{primitives.lineHeight.tight}",
      "snug": "{primitives.lineHeight.snug}",
      "normal": "{primitives.lineHeight.normal}",
      "relaxed": "{primitives.lineHeight.relaxed}"
    },
    "spacing": {
      "1": "{primitives.spacing.1}",
      "2": "{primitives.spacing.2}",
      "3": "{primitives.spacing.3}",
      "4": "{primitives.spacing.4}",
      "5": "{primitives.spacing.5}",
      "6": "{primitives.spacing.6}",
      "8": "{primitives.spacing.8}",
      "10": "{primitives.spacing.10}",
      "12": "{primitives.spacing.12}",
      "16": "{primitives.spacing.16}",
      "20": "{primitives.spacing.20}",
      "24": "{primitives.spacing.24}"
    },
    "borderRadius": {
      "sm": "{primitives.borderRadius.sm}",
      "md": "{primitives.borderRadius.md}",
      "lg": "{primitives.borderRadius.lg}",
      "xl": "{primitives.borderRadius.xl}",
      "full": "{primitives.borderRadius.full}"
    },
    "shadow": {
      "sm": "{primitives.shadow.sm}",
      "md": "{primitives.shadow.md}",
      "lg": "{primitives.shadow.lg}",
      "glass": "{primitives.shadow.glass}"
    },
    "transition": {
      "instant": "{primitives.transition.instant}",
      "fast": "{primitives.transition.fast}",
      "normal": "{primitives.transition.normal}",
      "slow": "{primitives.transition.slow}",
      "cinematic": "{primitives.transition.cinematic}",
      "epic": "{primitives.transition.epic}"
    },
    "easing": {
      "spring": "{primitives.easing.spring}",
      "springSharp": "{primitives.easing.springSharp}",
      "expo": "{primitives.easing.expo}",
      "bounce": "{primitives.easing.bounce}"
    },
    "motion": {
      "entryDelay": "{primitives.motion.entryDelay}",
      "stagger": "{primitives.motion.stagger}",
      "parallaxDepth": "{primitives.motion.parallaxDepth}",
      "magneticRadius": "{primitives.motion.magneticRadius}"
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": "{semantic.color.primary}",
        "hover": "{semantic.color.primaryHover}",
        "active": "{semantic.color.violet-700}",
        "text": "{primitives.color.white}",
        "disabled": "{semantic.color.mutedForeground}"
      },
      "secondary": {
        "bg": "{semantic.color.muted}",
        "hover": "{semantic.color.zinc-200}",
        "text": "{semantic.color.zinc-900}"
      },
      "accent": {
        "bg": "{semantic.color.accent}",
        "hover": "{semantic.color.accentHover}",
        "text": "{primitives.color.black}"
      },
      "ghost": {
        "bg": "transparent",
        "hover": "{semantic.color.muted}",
        "text": "{semantic.color.foreground}"
      },
      "destructive": {
        "bg": "{semantic.color.destructive}",
        "hover": "#E11D48",
        "text": "{primitives.color.white}"
      },
      "radius": "{semantic.borderRadius.full}",
      "padding": {
        "sm": "8px 16px",
        "md": "12px 24px",
        "lg": "16px 32px"
      },
      "transition": "{semantic.transition.fast}",
      "easing": "{semantic.easing.spring}"
    },
    "card": {
      "bg": "{semantic.color.card}",
      "border": "{semantic.color.border}",
      "radius": "{semantic.borderRadius.xl}",
      "padding": "{semantic.spacing.6}",
      "shadow": "{semantic.shadow.sm}",
      "hover": {
        "shadow": "{semantic.shadow.lg}",
        "border": "{semantic.color.primaryMuted}",
        "transform": "scale(1.01)"
      },
      "doubleBezel": {
        "outer": {
          "bg": "rgba(0,0,0,0.02)",
          "border": "rgba(0,0,0,0.05)",
          "padding": "6px",
          "radius": "24px"
        },
        "inner": {
          "bg": "rgba(255,255,255,0.8)",
          "radius": "20.625px",
          "insetShadow": "inset 0 1px 1px rgba(255,255,255,0.15)"
        }
      }
    },
    "input": {
      "bg": "{semantic.color.background}",
      "border": "{semantic.color.inputBorder}",
      "radius": "{semantic.borderRadius.md}",
      "padding": "12px 16px",
      "fontSize": "{primitives.fontSize.base}",
      "placeholderColor": "{semantic.color.zinc-400}",
      "focus": {
        "border": "{semantic.color.focusRing}",
        "ring": "0 0 0 3px rgba(124, 58, 237, 0.2)",
        "outline": "none"
      },
      "error": {
        "border": "{semantic.color.destructive}",
        "ring": "0 0 0 3px rgba(244, 63, 94, 0.2)"
      },
      "label": {
        "transform": "translateY(-50%) scale(0.85)",
        "origin": "top left",
        "color": "{semantic.color.zinc-500}",
        "transition": "{semantic.transition.fast}"
      }
    },
    "avatar": {
      "sizes": {
        "xs": "24px",
        "sm": "32px",
        "md": "40px",
        "lg": "48px",
        "xl": "56px",
        "2xl": "64px"
      },
      "radius": "{semantic.borderRadius.full}",
      "stackOverlap": "-8px",
      "statusRing": {
        "size": "8px",
        "border": "2px solid var(--color-card)"
      }
    },
    "badge": {
      "radius": "{semantic.borderRadius.full}",
      "padding": "4px 10px",
      "fontSize": "{primitives.fontSize.xs}",
      "fontWeight": "{semantic.fontWeight.medium}",
      "variants": {
        "primary": {
          "bg": "{semantic.color.primary}",
          "text": "{primitives.color.white}"
        },
        "success": {
          "bg": "{semantic.color.success}",
          "text": "{primitives.color.white}"
        },
        "warning": {
          "bg": "{semantic.color.warning}",
          "text": "{primitives.color.black}"
        },
        "destructive": {
          "bg": "{semantic.color.destructive}",
          "text": "{primitives.color.white}"
        },
        "neutral": {
          "bg": "{semantic.color.muted}",
          "text": "{semantic.color.mutedForeground}"
        }
      }
    },
    "dropdown": {
      "bg": "{semantic.color.card}",
      "border": "{semantic.color.border}",
      "radius": "{semantic.borderRadius.lg}",
      "shadow": "{semantic.shadow.lg}",
      "itemPadding": "10px 16px",
      "itemHoverBg": "{semantic.color.muted}",
      "separator": "{semantic.color.border}",
      "animation": {
        "enter": "slide-up-fade",
        "duration": "200ms",
        "easing": "{semantic.easing.spring}",
        "stagger": "80ms"
      }
    },
    "modal": {
      "overlayBg": "rgba(0,0,0,0.6)",
      "overlayBlur": "backdrop-blur-xl",
      "bg": "{semantic.color.card}",
      "radius": "{semantic.borderRadius.xl}",
      "shadow": "{semantic.shadow.glass}",
      "maxWidth": "560px",
      "animation": {
        "enter": "scale-fade",
        "exit": "scale-fade",
        "duration": "300ms",
        "easing": "{semantic.easing.spring}"
      }
    },
    "toast": {
      "bg": "{semantic.color.card}",
      "border": "{semantic.color.border}",
      "radius": "{semantic.borderRadius.lg}",
      "padding": "16px 20px",
      "shadow": "{semantic.shadow.lg}",
      "animation": {
        "enter": "slide-right",
        "exit": "slide-right-exit",
        "duration": "300ms",
        "easing": "{semantic.easing.spring}"
      },
      "progressBar": {
        "height": "3px",
        "bg": "{semantic.color.primary}"
      }
    },
    "tabs": {
      "indicator": {
        "height": "3px",
        "bg": "{semantic.color.primary}",
        "radius": "full",
        "animation": {
          "duration": "300ms",
          "easing": "{semantic.easing.spring}"
        }
      },
      "itemPadding": "12px 20px",
      "fontSize": "{primitives.fontSize.sm}",
      "fontWeight": "{semantic.fontWeight.medium}"
    },
    "table": {
      "headerBg": "{semantic.color.muted}",
      "headerTextColor": "{semantic.color.mutedForeground}",
      "rowHoverBg": "{semantic.color.muted}",
      "border": "{semantic.color.border}",
      "cellPadding": "12px 16px",
      "fontSize": "{primitives.fontSize.sm}",
      "stickyHeader": true
    },
    "avatarStack": {
      "overlap": "-8px",
      "maxVisible": 3,
      "border": "2px solid {semantic.color.card}"
    },
    "motion": {
      "magneticButton": {
        "radius": "{primitives.motion.magneticRadius}",
        "maxOffset": "12px",
        "trailingIconScale": "1.05",
        "trailingIconOffset": "1.5x"
      },
      "stickyStack": {
        "scale": "0.92",
        "opacity": "0.55",
        "pinType": "top top"
      },
      "horizontalPan": {
        "scrub": 1,
        "pinType": "top top"
      },
      "horizontalMarquee": {
        "duration": 30,
        "repeat": -1,
        "ease": "none"
      },
      "magneticNav": {
        "closedState": {
          "marginTop": "24px",
          "width": "max-content",
          "borderRadius": "full",
          "blur": "backdrop-blur-2xl"
        },
        "hamburgerMorph": {
          "duration": 300,
          "easing": "{semantic.easing.spring}"
        },
        "modalExpansion": {
          "backdropBlur": "backdrop-blur-3xl",
          "overlayOpacity": 0.8,
          "staggerDelay": 100
        }
      },
      "scrollReveal": {
        "initial": "translate-y-16 blur-md opacity-0",
        "final": "translate-y-0 blur-0 opacity-100",
        "duration": 800,
        "delay": 100,
        "stagger": 80,
        "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "magneticButton": {
        "magneticRadius": "80px",
        "maxOffset": "12px",
        "pressScale": 0.98,
        "trailingIconOffset": 1.5,
        "trailingIconScale": 1.05
      },
      "scrollReveal": {
        "initial": "translate-y-16 blur-md opacity-0",
        "final": "translate-y-0 blur-0 opacity-100",
        "duration": 800,
        "delay": 100,
        "stagger": 80,
        "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
      }
    }
  }
}