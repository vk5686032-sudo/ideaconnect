# Frontend environment. Copy to `.env` and adjust for your machine.
#
# In development, Vite serves the app on :5173 and talks to the backend
# directly, so use the backend's LAN address (a physical device or another
# machine on the same Wi-Fi needs this, not localhost).
#
# Find your LAN IP: `ipconfig` -> IPv4 Address of the Wi-Fi adapter.
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Behind the Docker/nginx stack the frontend is served on the same origin as
# the API, so both can be left empty and nginx proxies /api and /socket.io:
# VITE_API_URL=/api/v1
# VITE_SOCKET_URL=
